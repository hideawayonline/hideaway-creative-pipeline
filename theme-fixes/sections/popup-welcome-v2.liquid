    <button class="hwp-teaser" id="hwp-teaser" type="button" aria-label="Open offer">
      <span class="hwp-teaser-dot"></span>
      {{ s.teaser_text | default: "GET 12% OFF" }}
    </button>

    <script>
    (function () {
      'use strict';
      const CFG = {
        companyId:   {{ s.klaviyo_company_id | default: 'M7xxfa' | json }},
        emailListId: {{ s.email_list_id      | default: 'UiypqE' | json }},
        smsListId:   {{ s.sms_list_id        | default: 'V7rcLr' | json }},
        delayMs:     {{ s.delay_seconds      | default: 8 | times: 1000 | json }},
        scrollPercent: {{ s.scroll_percent   | default: 30 | json }},
        enableExitIntent: {{ s.enable_exit_intent | default: true | json }},
        cooldownDays: {{ s.cooldown_days     | default: 30 | json }},
        excludePaths: {{ exclude_csv | split: ',' | json }}
      };

      const $ = (sel) => document.querySelector(sel);
      const overlay = $('#hwp-overlay');
      const teaser  = $('#hwp-teaser');
      const STORAGE_DISMISSED  = 'hwp-popup-dismissed';
      const STORAGE_SUBSCRIBED = 'hwp-popup-subscribed';
      const isDesktop = () => window.matchMedia('(min-width: 768px)').matches;

      let capturedEmail = null;

      // iOS Safari and in-app browsers (Instagram/Facebook) ignore
      // body{overflow:hidden}, so the page kept scrolling behind the overlay
      // while the overlay swallowed taps. Locking with position:fixed and
      // restoring the scroll offset works everywhere.
      let lockedScrollY = null;
      function lockScroll() {
        if (lockedScrollY !== null) return;
        lockedScrollY = window.scrollY || document.documentElement.scrollTop || 0;
        document.body.style.position = 'fixed';
        document.body.style.top = '-' + lockedScrollY + 'px';
        document.body.style.left = '0';
        document.body.style.right = '0';
        document.body.style.width = '100%';
      }
      function unlockScroll() {
        if (lockedScrollY === null) return;
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.left = '';
        document.body.style.right = '';
        document.body.style.width = '';
        window.scrollTo(0, lockedScrollY);
        lockedScrollY = null;
      }

      function show() {
        overlay.classList.add('hwp-visible');
        overlay.setAttribute('aria-hidden', 'false');
        teaser.classList.remove('hwp-visible');
        lockScroll();
        if (isDesktop()) setTimeout(() => $('#hwp-email')?.focus(), 300);
      }
      function dismiss() {
        unlockScroll();
        overlay.classList.remove('hwp-visible');
        overlay.setAttribute('aria-hidden', 'true');
        setExpiry(STORAGE_DISMISSED, CFG.cooldownDays);
        if (!isSubscribed()) showTeaser();
      }
      function showTeaser() {
        if (isSubscribed()) return;
        teaser.classList.add('hwp-visible');
      }
      function goto(step) {
        document.querySelectorAll('.hwp-step').forEach(el => el.classList.remove('hwp-active'));
        const target = document.querySelector('.hwp-step[data-step="' + step + '"]');
        if (target) {
          target.classList.add('hwp-active');
          if (isDesktop()) {
            const firstInput = target.querySelector('input');
            if (firstInput) setTimeout(() => firstInput.focus(), 200);
          }
        }
      }

      // Dismissal is stored in localStorage AND a cookie: in-app browsers
      // frequently drop localStorage between visits, which made the popup
      // reappear on every page view for Instagram/Facebook traffic.
      function setExpiry(key, days) {
        const exp = String(Date.now() + days * 86400000);
        try { localStorage.setItem(key, exp); } catch (e) {}
        try {
          document.cookie = key + '=' + exp + '; max-age=' + (days * 86400) + '; path=/; SameSite=Lax';
        } catch (e) {}
      }
      function readExpiry(key) {
        let best = 0;
        try {
          const v = localStorage.getItem(key);
          if (v) best = Math.max(best, parseInt(v, 10) || 0);
        } catch (e) {}
        try {
          const m = document.cookie.match(new RegExp('(?:^|;\\s*)' + key + '=([^;]+)'));
          if (m) best = Math.max(best, parseInt(m[1], 10) || 0);
        } catch (e) {}
        return best;
      }
      function isExpired(key) {
        const v = readExpiry(key);
        if (!v) return true;
        return Date.now() > v;
      }
      function isDismissedRecently() { return !isExpired(STORAGE_DISMISSED); }
      function isSubscribed()        { return !isExpired(STORAGE_SUBSCRIBED); }

      function validEmail(s) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(String(s).trim()); }
      function validPhoneAU(s) {
        const digits = String(s).replace(/\D/g, '');
        if (digits.length === 9 && digits[0] === '4')         return '+61' + digits;
        if (digits.length === 10 && digits.startsWith('04'))  return '+61' + digits.slice(1);
        if (digits.length === 11 && digits.startsWith('614')) return '+' + digits;
        return null;
      }

      async function klaviyoSubscribe({ email, phone, listId }) {
        const profileAttrs = {};
        if (email) profileAttrs.email = email;
        if (phone) profileAttrs.phone_number = phone;
        const subscriptions = {};
        if (email) subscriptions.email = { marketing: { consent: 'SUBSCRIBED' } };
        if (phone) subscriptions.sms   = { marketing: { consent: 'SUBSCRIBED' } };
        profileAttrs.subscriptions = subscriptions;
        const body = {
          data: {
            type: 'subscription',
            attributes: {
              custom_source: 'hideAWAY Welcome Popup V2',
              profile: { data: { type: 'profile', attributes: profileAttrs } }
            },
            relationships: { list: { data: { type: 'list', id: listId } } }
          }
        };
        const url = 'https://a.klaviyo.com/client/subscriptions/?company_id=' + encodeURIComponent(CFG.companyId);
        const res = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'revision': '2026-04-15' },
          body: JSON.stringify(body)
        });
        if (!res.ok) {
          const text = await res.text().catch(() => '');
          throw new Error('Klaviyo error ' + res.status + ': ' + text.slice(0, 200));
        }
        return { ok: true };
      }

      function setError(field, msg) {
        const el = $('#hwp-' + field + '-error');
        if (el) el.textContent = msg || '';
      }
      function setBusy(btn, busy, busyLabel) {
        if (!btn) return;
        if (busy) { btn.dataset.label = btn.textContent; btn.textContent = busyLabel; btn.disabled = true; }
        else { btn.textContent = btn.dataset.label || btn.textContent; btn.disabled = false; }
      }

      $('#hwp-email-form').addEventListener('submit', async function (e) {
        e.preventDefault();
        setError('email', '');
        const email = $('#hwp-email').value.trim();
        if (!validEmail(email)) { setError('email', 'Looks like that email is missing something.'); return; }
        const btn = $('#hwp-email-submit');
        setBusy(btn, true, 'Sending…');
        try {
          await klaviyoSubscribe({ email, listId: CFG.emailListId });
          capturedEmail = email;
          setExpiry(STORAGE_SUBSCRIBED, 365);
          goto(2);
        } catch (err) {
          console.error('[hwp-popup]', err);
          setError('email', "Hmm, that didn't go through. Try again?");
        } finally { setBusy(btn, false); }
      });

      $('#hwp-sms-form').addEventListener('submit', async function (e) {
        e.preventDefault();
        setError('phone', '');
        const phone = validPhoneAU($('#hwp-phone').value);
        if (!phone) { setError('phone', 'Aussie mobile number, please (e.g. 0412 345 678)'); return; }
        const btn = $('#hwp-sms-submit');
        setBusy(btn, true, 'Sending…');
        try {
          await klaviyoSubscribe({ email: capturedEmail, phone, listId: CFG.smsListId });
          goto(3);
        } catch (err) {
          console.error('[hwp-popup]', err);
          setError('phone', "Hmm, that didn't go through. Try again?");
        } finally { setBusy(btn, false); }
      });

      const coupon = $('#hwp-coupon');
      if (coupon) {
        coupon.addEventListener('click', function () {
          const code = coupon.dataset.code;
          if (!code) return;
          const copyFallback = () => {
            const ta = document.createElement('textarea');
            ta.value = code; ta.style.position = 'fixed'; ta.style.opacity = '0';
            document.body.appendChild(ta); ta.select();
            try { document.execCommand('copy'); } catch (e) {}
            document.body.removeChild(ta);
          };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(code).catch(copyFallback);
          } else {
            copyFallback();
          }
          const badge = $('#hwp-coupon-copied');
          if (badge) {
            badge.classList.add('hwp-show');
            setTimeout(() => badge.classList.remove('hwp-show'), 1400);
          }
        });
      }

      document.addEventListener('click', function (e) {
        const t = e.target;
        if (t === overlay) { dismiss(); return; }
        const action = t.dataset && t.dataset.action;
        if (!action) return;
        if (action === 'dismiss')       { dismiss(); }
        if (action === 'dismiss-track') { setExpiry(STORAGE_SUBSCRIBED, 365); unlockScroll(); }
        if (action === 'skip-sms')      { goto(3); }
      });
      $('#hwp-close').addEventListener('click', dismiss);
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && overlay.classList.contains('hwp-visible')) dismiss();
      });
      teaser.addEventListener('click', show);

      function shouldSuppress() {
        const path = location.pathname.toLowerCase();
        if (CFG.excludePaths.some(p => path.startsWith(String(p).trim()))) return true;
        if (isDismissedRecently()) return true;
        if (isSubscribed()) return true;
        return false;
      }

      function armTriggers() {
        if (shouldSuppress()) {
          if (isDismissedRecently() && !isSubscribed()) showTeaser();
          return;
        }
        let triggered = false;
        const fire = () => { if (triggered) return; triggered = true; show(); };
        setTimeout(fire, CFG.delayMs);
        // No scroll trigger on product pages: reading a product description
        // on a phone is 30% scroll, so the popup was interrupting every PDP
        // read. The timer above still fires once.
        const isProductPage = location.pathname.toLowerCase().indexOf('/products/') !== -1;
        if (!isProductPage) {
          function onScroll() {
            const h = document.documentElement;
            const total = h.scrollHeight - h.clientHeight;
            if (total <= 0) return;
            const pct = (h.scrollTop / total) * 100;
            if (pct >= CFG.scrollPercent) fire();
          }
          window.addEventListener('scroll', onScroll, { passive: true });
        }
        if (CFG.enableExitIntent && isDesktop()) {
          document.addEventListener('mouseout', function (e) {
            if (e.clientY <= 0 && !e.relatedTarget) fire();
          });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', armTriggers);
      } else {
        armTriggers();
      }

      window.HWP = { show, dismiss, goto, showTeaser, _cfg: CFG };
    })();
    </script>

  {%- endunless -%}
{%- endif -%}

