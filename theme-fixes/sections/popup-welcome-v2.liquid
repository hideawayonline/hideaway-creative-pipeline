              <span class="hwp-wordmark"><img src="{{ s.logo_image | image_url: width: 200 }}" alt="hideaway."></span>
            {%- else -%}
              <span class="hwp-wordmark">hideaway.</span>
            {%- endif -%}
          </div>
          <div class="hwp-body">
            <h2 class="hwp-headline">{{ s.success_headline | default: "You're in." }}</h2>
            <p class="hwp-sub">{{ s.success_sub | default: "Copy your code, use it at checkout, thank us later." }}</p>
            <div class="hwp-coupon" id="hwp-coupon" data-code="{{ s.coupon_code | default: 'WELCOME12' }}">
